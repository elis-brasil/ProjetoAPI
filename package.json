{
  "name": "monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "api",
    "frontend"
  ],
  "scripts": {
    "start:api": "npm start --workspace=api",
    "start:frontend": "npm start --workspace=frontend",
    "dev": "npx concurrently \"npm run start:api\" \"npm run start:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}